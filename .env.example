# ==========================================
# FEMORA Environment Configuration
# ==========================================

# Server-Side Variables (Vercel Serverless Function only)
# NEVER prefix these with VITE_ to keep them private from browser bundles.
GEMINI_API_KEY=
XAI_API_KEY=
AI_PRIMARY_MODEL=gemini-1.5-flash
AI_FALLBACK_MODEL=grok-2-mini
AI_ENABLED=true
AI_TIMEOUT_MS=8000
AI_MAX_TOKENS=600
AI_RATE_LIMIT_PER_MIN=20

# Frontend Build-Time Variables (Exposed to browser)
VITE_AI_ENDPOINT=/api/ai
VITE_APP_ENV=development
VITE_USE_MOCKS=false
