 byType:async<T extends BaseEntity & {type:string}>(table:Table<T,string>,profileId:Id,type:string,journey?:string)=>{if(journey&&table.schema.indexes.some(i=>i.name==='[profileId+journey+type]')){const revision=ensureProfile(profileId),settings=await db.settings.where('profileId').equals(profileId).first(),rows=await table.where('[profileId+journey+type]').equals([profileId,journey,type]).toArray(),items=await Promise.all(rows.map(r=>scoped.decode(r,settings)));if(revision!==sessionRevision)throw new CoreError('LOCKED','Profile changed during type query');return items}return(await scoped.list(table,profileId)).filter(r=>r.type===type&&(!journey||((r as T&{journey?:string}).journey===journey)))},
 byDate:async<T extends BaseEntity & {date?:string}>(table:Table<T,string>,profileId:Id,start:string,end:string)=>{if(!isoDateSchema.safeParse(start).success||!isoDateSchema.safeParse(end).success||start>end)throw new CoreError('VALIDATION','Date range is invalid');const dateIndex=table.schema.indexes.some(i=>i.name==='[profileId+date]'),timeIndex=table.schema.indexes.some(i=>i.name==='[profileId+dateTime]');if(!dateIndex&&!timeIndex)return(await scoped.list(table,profileId)).filter(r=>r.date!==undefined&&r.date>=start&&r.date<=end);const revision=ensureProfile(profileId),settings=await db.settings.where('profileId').equals(profileId).first(),rows=dateIndex?await table.where('[profileId+date]').between([profileId,start],[profileId,end],true,true).toArray():await table.where('[profileId+dateTime]').between([profileId,`${start}T00:00:00.000Z`],[profileId,`${end}T23:59:59.999Z`],true,true).toArray(),items=await Promise.all(rows.map(r=>scoped.decode(r,settings)));if(revision!==sessionRevision)throw new CoreError('LOCKED','Profile changed during date query');return items}
};
export function repository<T extends BaseEntity>(table:Table<T,string>){return{create:(profileId:string,value:Omit<T,'id'|'profileId'|'createdAt'|'updatedAt'>)=>scoped.add(table,profileId,value),get:(profileId:string,id:string)=>scoped.get(table,profileId,id),list:(profileId:string)=>scoped.list(table,profileId),update:(profileId:string,id:string,patch:Partial<T>)=>scoped.update(table,profileId,id,patch),delete:(profileId:string,id:string)=>scoped.delete(table,profileId,id),byJourney:(profileId:string,journey:string)=>scoped.byJourney(table as Table<T&{journey:string},string>,profileId,journey),byType:(profileId:string,type:string,journey?:string)=>scoped.byType(table as Table<T&{type:string},string>,profileId,type,journey),byDate:(profileId:string,start:string,end:string)=>scoped.byDate(table as Table<T&{date?:string},string>,profileId,start,end)}}
export const dataRepositories={healthProfile:repository(db.healthProfile),journeyProfiles:repository(db.journeyProfiles),checkins:repository(db.checkins),records:repository(db.records),appointments:repository(db.appointments),notifications:repository(db.notifications),bookmarks:repository(db.bookmarks),recentlyViewed:repository(db.recentlyViewed),consents:repository(db.consents)};
export async function getSettings(profileId:string){return db.settings.where('profileId').equals(profileId).first()}
export function captureProfileRevision(profileId:string){return ensureProfile(profileId)}
export function assertProfileRevision(profileId:string,revision:number){if(revision!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile context changed during operation');return ensureProfile(profileId)}
export async function saveSecuritySettings(setting:Settings,key:CryptoKey){let revision=ensureProfile(setting.profileId);if(!await db.profiles.get(setting.profileId))throw new CoreError('NOT_FOUND','Profile not found');if(!settingsInputSchema.safeParse(setting).success)throw new CoreError('VALIDATION','Security settings failed validation');const old=await db.settings.get(setting.id);if(old?.pinEnabled)throw new CoreError('CONFLICT','PIN protection is already configured');if(revision!==sessionRevision||activeProfileId!==setting.profileId)throw new CoreError('LOCKED','Profile changed while enabling protection');profiles.clearActive(setting.profileId);revision=sessionRevision;const sensitive=['data','symptoms','notes','conditions','allergies','medications','birthDate','title','message','metadata'];const staged:{table:Table<BaseEntity,string>;before:BaseEntity&Record<string,unknown>;after:BaseEntity&Record<string,unknown>}[]=[];for(const table of tables()){if(table.name==='settings')continue;for(const raw of await table.where('profileId').equals(setting.profileId).toArray()){const before=raw as BaseEntity&Record<string,unknown>,after={...before};if(after.encryptedPayload)continue;const payload:Record<string,unknown>={};for(const k of sensitive)if(k in after){payload[k]=after[k];delete after[k]}if(Object.keys(payload).length){const meta={profileId:after.profileId,id:after.id,journey:'journey'in after?String(after.journey):'',type:'type'in after?String(after.type):'',updatedAt:after.updatedAt};after.encryptedPayload=await encryptPayload(key,payload,meta);staged.push({table,before,after})}}}if(revision!==sessionRevision)throw new CoreError('LOCKED','Profile changed while enabling protection');try{await db.transaction('rw',[db.settings,...tables()],async()=>{for(const item of staged){const current=await item.table.get(item.before.id);if(!current||current.profileId!==setting.profileId||current.updatedAt!==item.before.updatedAt||(current as BaseEntity&{encryptedPayload?:unknown}).encryptedPayload)throw new CoreError('CONFLICT','Profile data changed while enabling protection');await item.table.put(item.after)}if(revision!==sessionRevision)throw new CoreError('LOCKED','Profile changed while enabling protection');await db.settings.put(setting)});}catch(e){if(isQuota(e))throw new CoreError('STORAGE_FULL','Storage is full');throw e}}
export async function snapshotProfile(profileId:string){const revision=ensureProfile(profileId);return db.transaction('r',[db.profiles,...tables()],async()=>{if(revision!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed before backup');const profile=await db.profiles.get(profileId);if(!profile)throw new CoreError('NOT_FOUND','Profile not found');const result:Record<string,unknown[]>={profiles:[profile]};for(const table of tables())result[table.name]=await table.where('profileId').equals(profileId).toArray();if(revision!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed during backup');return result})}
export async function restoreProfile(profileId:string,data:Record<string,unknown[]>){const revision=ensureProfile(profileId),names=['healthProfile','journeyProfiles','checkins','records','appointments','notifications','bookmarks','recentlyViewed','consents','settings'];await db.transaction('rw',[db.profiles,...tables()],async()=>{if(!await db.profiles.get(profileId))throw new CoreError('NOT_FOUND','Profile not found');for(const name of names)for(const raw of data[name]??[]){const row=raw as{id?:string;profileId?:string};if(!row.id||row.profileId!==profileId)throw new CoreError('VALIDATION','Backup contains invalid or cross-profile record');const parsed=databaseRowSchemas[name]?.safeParse(raw);if(!parsed?.success)throw new CoreError('VALIDATION','Backup record failed validation');const normalized=parsed.data as{id:string;profileId:string};const table=db.table(name),existing=await table.get(normalized.id);if(existing){if(JSON.stringify(existing)!==JSON.stringify(normalized))throw new CoreError('CONFLICT','Backup conflicts with an existing record');continue}await table.put(normalized)}if(revision!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile context changed during restore')});if((await getSettings(profileId))?.pinEnabled)profiles.clearActive(profileId)}
export async function addRecord(profileId:string,journey:'menstrual'|'maternity'|'menopause',type:string,data:Record<string,unknown>){return scoped.add(db.records,profileId,{journey,type,data})}
export async function addAppointment(profileId:string,journey:Journey,value:{dateTime:string;title:string;notes?:string}){const parsed=validateWrite(db.appointments,{...value,journey});return scoped.add(db.appointments,profileId,parsed as Omit<Appointment,'id'|'profileId'|'createdAt'|'updatedAt'>)}
export async function saveHealthProfile(profileId:string,value:Omit<HealthProfile,'id'|'profileId'|'createdAt'|'updatedAt'>){return scoped.add(db.healthProfile,profileId,value)}
export async function listRecords(profileId:string,journey?:Journey){return(await scoped.list(db.records,profileId)).filter(r=>!journey||r.journey===journey)}
export async function deleteRecord(profileId:string,id:string){const row=await scoped.get(db.records,profileId,id);await scoped.delete(db.records,profileId,id);return row}
export type {StoragePersistenceStatus} from '../core/contracts';
let lastStoragePersistenceStatus:StoragePersistenceStatus={state:'unsupported',supported:false,granted:false};
export async function requestStoragePersistenceStatus():Promise<StoragePersistenceStatus>{try{if(typeof navigator==='undefined'||!navigator.storage?.persist){lastStoragePersistenceStatus={state:'unsupported',supported:false,granted:false};return lastStoragePersistenceStatus}const granted=await navigator.storage.persist();lastStoragePersistenceStatus={state:granted?'granted':'denied',supported:true,granted};return lastStoragePersistenceStatus}catch{lastStoragePersistenceStatus={state:'error',supported:true,granted:false};return lastStoragePersistenceStatus}}
export async function requestStoragePersistence(){return(await requestStoragePersistenceStatus()).granted}
export async function getStoragePersistenceDetails():Promise<StoragePersistenceStatus>{try{if(typeof navigator==='undefined'||!navigator.storage?.persisted){lastStoragePersistenceStatus={state:'unsupported',supported:false,granted:false};return lastStoragePersistenceStatus}const granted=await navigator.storage.persisted();lastStoragePersistenceStatus={state:granted?'granted':'denied',supported:true,granted};return lastStoragePersistenceStatus}catch{lastStoragePersistenceStatus={state:'error',supported:true,granted:false};return lastStoragePersistenceStatus}}
export async function getStoragePersistenceStatus(){return(await getStoragePersistenceDetails()).granted}
export const journeys={activate:async(profileId:string,journey:'menstrual'|'maternity'|'menopause')=>{if(!journeySchema.safeParse(journey).success)throw new CoreError('VALIDATION','Journey is invalid');const revision=ensureProfile(profileId);return db.transaction('rw',[db.profiles,db.journeyProfiles],async()=>{const p=await db.profiles.get(profileId);if(!p)throw new CoreError('NOT_FOUND','Profile not found');const current=await activateJourneyState(profileId,journey);p.activeJourney=journey;p.updatedAt=stamp();await db.profiles.put(p);if(revision!==sessionRevision)throw new CoreError('LOCKED','Profile changed during journey switch');return current})},
 markPostpartum:async(profileId:string,startedAt:string)=>{if(!isoDateSchema.safeParse(startedAt).success)throw new CoreError('VALIDATION','Postpartum date is invalid');const revision=ensureProfile(profileId);return db.transaction('rw',[db.profiles,db.journeyProfiles],async()=>{const rows=await db.journeyProfiles.where({profileId,journey:'maternity'}).toArray(),now=stamp();let state=rows.find(r=>r.status==='active');if(!state){state={id:uuid(),profileId,journey:'maternity',status:'active',startedAt,metadata:{},createdAt:now,updatedAt:now};await db.journeyProfiles.add(state)}if(state.metadata?.stage==='postpartum')return{changed:false,state};state.metadata={...state.metadata,stage:'postpartum',postpartumStartedAt:startedAt};state.updatedAt=now;await db.journeyProfiles.put(state);const profile=await db.profiles.get(profileId);if(!profile)throw new CoreError('NOT_FOUND','Profile not found');profile.activeJourney='maternity';profile.updatedAt=now;await db.profiles.put(profile);if(revision!==sessionRevision)throw new CoreError('LOCKED','Profile changed during transition');return{changed:true,state}})}
}





journeys.markPostpartum=async(profileId:string,startedAt:string)=>{if(!isoDateSchema.safeParse(startedAt).success)throw new CoreError('VALIDATION','Postpartum date is invalid');const revision=ensureProfile(profileId),setting=await getSettings(profileId);if(setting?.pinEnabled&&(!activeVault?.key||activeVault.profileId!==profileId))throw new CoreError('LOCKED','Unlock this profile before changing maternity state');const stored=(await db.journeyProfiles.where({profileId,journey:'maternity'}).toArray()).find(r=>r.status==='active');let state=stored?await scoped.decode({...stored},setting):undefined;if(state?.metadata?.stage==='postpartum')return{changed:false,state};const now=stamp();state=state??{id:uuid(),profileId,journey:'maternity',status:'active' as const,startedAt,metadata:{},createdAt:now,updatedAt:now};state.metadata={...state.metadata,stage:'postpartum',postpartumStartedAt:startedAt};state.updatedAt=now;const before=stored?.updatedAt;if(setting?.pinEnabled){const payload={metadata:state.metadata};delete (state as JourneyProfile&{encryptedPayload?:unknown}).metadata;const meta={profileId,id:state.id,journey:'maternity',type:'',updatedAt:state.updatedAt};(state as JourneyProfile&{encryptedPayload?:unknown}).encryptedPayload=await encryptPayload(activeVault!.key!,payload,meta)}const profile=await db.profiles.get(profileId);if(!profile)throw new CoreError('NOT_FOUND','Profile not found');profile.activeJourney='maternity';profile.updatedAt=now;await db.transaction('rw',[db.profiles,db.journeyProfiles],async()=>{if(revision!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed during transition');const latest=stored?await db.journeyProfiles.get(stored.id):undefined;if(stored&&(!latest||latest.updatedAt!==before))throw new CoreError('CONFLICT','Maternity state changed during transition');await db.journeyProfiles.put(state!);await db.profiles.put(profile);if(revision!==sessionRevision)throw new CoreError('LOCKED','Profile changed during transition')});return{changed:true,state:setting?.pinEnabled?await scoped.decode({...state!},setting):state}};

