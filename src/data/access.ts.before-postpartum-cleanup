import type{Profile,HealthProfile,JourneyProfile,CheckIn,HealthRecord,Appointment,Notification,Bookmark,RecentlyViewed,Consent,Settings,BaseEntity,Id,Journey,ProfileCreation,PublicProfile,ProfileWipeResult,StoragePersistenceStatus}from'../core/contracts';
import{checkInInputSchema,healthProfileInputSchema,healthRecordInputSchema,appointmentInputSchema,journeyProfileInputSchema,notificationInputSchema,bookmarkInputSchema,recentlyViewedInputSchema,consentInputSchema,profileInputSchema,settingsInputSchema,isoDateSchema,journeySchema,databaseRowSchemas}from'../contract/schemas';
export class CoreError extends Error{constructor(public code:'VALIDATION'|'STORAGE_FULL'|'LOCKED'|'NOT_FOUND'|'CONFLICT'|'CRYPTO'|'UNKNOWN',message:string){super(message);this.name='CoreError'}}
export class FemoraDB extends Dexie{
 profiles!:Table<Profile,string>;healthProfile!:Table<HealthProfile,string>;journeyProfiles!:Table<JourneyProfile,string>;checkins!:Table<CheckIn,string>;records!:Table<HealthRecord,string>;appointments!:Table<Appointment,string>;notifications!:Table<Notification,string>;bookmarks!:Table<Bookmark,string>;recentlyViewed!:Table<RecentlyViewed,string>;consents!:Table<Consent,string>;settings!:Table<Settings,string>;
 constructor(name='femora'){super(name);const schema={profiles:'id,profileId,updatedAt',healthProfile:'id,profileId,[profileId+updatedAt]',journeyProfiles:'id,profileId,journey,status,[profileId+journey]',checkins:'id,profileId,journey,date,[profileId+date],[profileId+journey+date]',records:'id,profileId,journey,type,date,[profileId+date],[profileId+journey+type]',appointments:'id,profileId,dateTime,[profileId+dateTime]',notifications:'id,profileId,readAt,[profileId+createdAt]',bookmarks:'id,profileId,targetType,targetId,[profileId+targetId]',recentlyViewed:'id,profileId,viewedAt,[profileId+viewedAt]',consents:'id,profileId,purpose,[profileId+purpose]',settings:'id,profileId'};const oldSchema={...schema,profiles:'id,updatedAt',records:'id,profileId,journey,type,date,[profileId+date]'};this.version(1).stores(oldSchema);this.version(2).stores(schema).upgrade(async tx=>{await tx.table('profiles').toCollection().modify(p=>{p.profileId=p.profileId??p.id});await tx.table('appointments').toCollection().modify(a=>{if(typeof a.dateTime==='string'&&Number.isFinite(Date.parse(a.dateTime)))a.dateTime=new Date(a.dateTime).toISOString()});await tx.table('settings').toCollection().modify(s=>{s.lockAfterMs=s.lockAfterMs??600000;s.pinCheck=s.pinCheck??s.pinVerifier;s.kdfVersion=s.kdfVersion??1})});this.version(3).stores({...schema,records:'id,profileId,journey,type,date,[profileId+date],[profileId+journey+type]'});this.version(4).stores({...schema,checkins:'id,profileId,journey,date,loggedAt,[profileId+date],[profileId+journey+date],[profileId+journey+loggedAt]'}).upgrade(async tx=>{await tx.table('checkins').toCollection().modify(c=>{if(typeof c.loggedAt!=='string'||!Number.isFinite(Date.parse(c.loggedAt)))c.loggedAt=typeof c.createdAt==='string'&&Number.isFinite(Date.parse(c.createdAt))?new Date(c.createdAt).toISOString():typeof c.date==='string'&&Number.isFinite(Date.parse(`${c.date}T00:00:00Z`))?new Date(`${c.date}T00:00:00Z`).toISOString():undefined});await tx.table('journeyPro