}
export const db=new FemoraDB();const stamp=()=>new Date().toISOString(),uuid=()=>crypto.randomUUID();let activeProfileId:string|null=null;let activeVault:{profileId:string;key:CryptoKey|undefined;lastActivity:number;locked:boolean;timer?:ReturnType<typeof setTimeout>}|null=null;let sessionRevision=0;
function expireVault(vault=activeVault,broadcast=true){if(broadcast&&vault)sessionChannel.invalidate(vault.profileId);if(vault){if(vault.timer)clearTimeout(vault.timer);vault.locked=true;vault.key=undefined}if(activeVault===vault){activeVault=null;activeProfileId=null;sessionRevision++}}
function handleRemoteInvalidation(profileId:string){if(activeProfileId!==profileId)return;if(activeVault)expireVault(activeVault,false);else{activeProfileId=null;sessionRevision++}}
const sessionChannel=createSessionInvalidationChannel(handleRemoteInvalidation);
export function closeSessionInvalidationChannel(){sessionChannel.close()}
function armAutoLock(vault:NonNullable<typeof activeVault>,revision:number){if(vault.timer)clearTimeout(vault.timer);vault.timer=setTimeout(()=>{if(activeVault===vault&&sessionRevision===revision){const remaining=600000-(Date.now()-vault.lastActivity);if(remaining>0)armAutoLock(vault,revision);else expireVault(vault)}},600000)}
function ensureProfile(profileId:string){if(!activeProfileId||activeProfileId!==profileId)throw new CoreError('LOCKED','Select this profile before accessing its data');if(activeVault&&(activeVault.profileId!==profileId||activeVault.locked||!activeVault.key||Date.now()-activeVault.lastActivity>=600000)){expireVault(activeVault);throw new CoreError('LOCKED','Profile is locked')};if(activeVault){activeVault.lastActivity=Date.now();armAutoLock(activeVault,sessionRevision)}return sessionRevision}
function isQuota(e:unknown){return!!e&&typeof e==='object'&&'name'in e&&((e as{name:string}).name==='QuotaExceededError'||(e as{name:string}).name==='NS_ERROR_DOM_QUOTA_REACHED')}
function validateWrite<T>(table:Table<T,string>,value:unknown){const schemas:Record<string,{safeParse:(v:unknown)=>{success:boolean;data?:unknown}}>= {checkins:checkInInputSchema,healthProfile:healthProfileInputSchema,records:healthRecordInputSchema,appointments:appointmentInputSchema,journeyProfiles:journeyProfileInputSchema,notifications:notificationInputSchema,bookmarks:bookmarkInputSchema,recentlyViewed:recentlyViewedInputSchema,consents:consentInputSchema};const schema=schemas[table.name];if(!schema)return value;const result=schema.safeParse(value);if(!result.success)throw new CoreError('VALIDATION','Record failed validation');return result.data}
function aad(meta:Record<string,string>){return new TextEncoder().encode(JSON.stringify(meta))}
async function encryptPayload(key:CryptoKey,payload:unknown,meta:Record<string,string>){const iv=crypto.getRandomValues(new Uint8Array(12)),additionalData=aad(meta),plain=new TextEncoder().encode(JSON.stringify(payload)),cipher=await crypto.subtle.encrypt({name:'AES-GCM',iv,additionalData},key,plain);return{iv:Array.from(iv),cipher:Array.from(new Uint8Array(cipher))}}
