const tables=()=>[db.healthProfile,db.journeyProfiles,db.checkins,db.records,db.appointments,db.notifications,db.bookmarks,db.recentlyViewed,db.consents,db.settings] as Table<BaseEntity,string>[];async function profileEncryptionStatus(profileId:string):Promise<boolean>{const setting=await db.settings.where('profileId').equals(profileId).first();if(!setting?.pinEnabled||!settingsInputSchema.safeParse(setting).success||!setting.pinSalt||!setting.pinCheck||!setting.kdfVersion||!setting.kdfIterations||!setting.encryptedDataKey)return false;const sensitive=['data','symptoms','notes','conditions','allergies','medications','birthDate','title','message','metadata'];for(const table of [db.healthProfile,db.journeyProfiles,db.checkins,db.records,db.appointments,db.notifications] as Table<BaseEntity,string>[]){for(const row of await table.where('profileId').equals(profileId).toArray()){const raw=row as BaseEntity&Record<string,unknown>;const hasPayload=raw.encryptedPayload!==undefined;const hasSensitive=sensitive.some(key=>key in raw);if(hasSensitive&&!hasPayload)return false;if(hasPayload){const parsed=databaseRowSchemas[table.name]?.safeParse(raw);if(!parsed?.success)return false}}}return true}
export async function getProfileEncryptionStatus(profileId:string){return profileEncryptionStatus(profileId)}
async function activateJourneyState(profileId:string,journey:Journey){const items=await db.journeyProfiles.where({profileId,journey}).toArray(),now=stamp();let current=items.find(item=>item.status==='active');if(current)return current;current=items[0];if(current){current.status='active';current.endedAt=undefined;current.updatedAt=now;await db.journeyProfiles.put(current);return current}const created:JourneyProfile={id:uuid(),profileId,journey,status:'active',startedAt:now.slice(0,10),createdAt:now,updatedAt:now};await db.journeyProfiles.add(created);return created}
export const profiles={
 create:async(displayName:string):Promise<ProfileCreation>=>{const parsed=profileInputSchema.safeParse({displayName});if(!parsed.success)throw new CoreError('VALIDATION','Profile did not pass validation');const firstProfile=(await db.profiles.count())===0;const storagePersistence=firstProfile?await requestStoragePersistenceStatus():await getStoragePersistenceDetails();const persistentStorageGranted=storagePersistence.granted;const profileId=uuid();const p:Profile={id:profileId,profileId,displayName:parsed.data.displayName,createdAt:stamp(),updatedAt:stamp()};try{await db.profiles.add(p);return{...p,isEncrypted:false,persistentStorageGranted,storagePersistence}}catch(e){if(isQuota(e))throw new CoreError('STORAGE_FULL','Storage is full');throw e}},
 list:async():Promise<PublicProfile[]>=>Promise.all((await db.profiles.toArray()).map(async p=>({...p,isEncrypted:await profileEncryptionStatus(p.id)}))),
 update:async(profileId:Id,patch:{displayName?:string;activeJourney?:Journey})=>{const revision=ensureProfile(profileId);try{return await db.transaction('rw',[db.profiles,db.journeyProfiles],async()=>{if(revision!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed before update');const old=await db.profiles.get(profileId);if(!old)throw new CoreError('NOT_FOUND','Profile not found');const parsed=profileInputSchema.safeParse({displayName:patch.displayName??old.displayName,activeJourney:patch.activeJourney??old.activeJourney});if(!parsed.success)throw new CoreError('VALIDATION','Profile update failed validation');const next={...old,...parsed.data,updatedAt:stamp()};if(patch.activeJourney)await activateJourneyState(profileId,patch.activeJourney);await db.profiles.put(next);if(revision!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed during update');return next})}catch(e){if(isQuota(e))throw new CoreError('STORAGE_FULL','Storage is full');throw e}},
 setActive:async(profileId:Id,vault?:{profileId:string;key:CryptoKey|undefined;lastActivity:number;locked:boolean;timer?:ReturnType<typeof setTimeout>})=>{const observed=sessionRevision,p=await db.profiles.get(profileId);if(!p)throw new CoreError('NOT_FOUND','Profile not found');const setting=await db.settings.where('profileId').equals(profileId).first();if(observed!==sessionRevision)throw new CoreError('LOCKED','Profile context changed while selecting');if(vault&&(vault.profileId!==profileId||vault.locked||!vault.key))throw new CoreError('LOCKED','Unlock this profile before selecting it');if(setting?.pinEnabled&&!vault)throw new CoreError('LOCKED','Unlock this profile before selecting it');if(activeProfileId===profileId&&activeVault===(vault??null))return{profile:p,revision:sessionRevision};if(activeVault)expireVault(activeVault);else if(activeProfileId)sessionChannel.invalidate(activeProfileId);activeVault=null;activeProfileId=null;sessionRevision++;activeProfileId=profileId;activeVault=vault??null;if(activeVault)armAutoLock(activeVault,sessionRevision);return{profile:p,revision:sessionRevision}},
 select:async(profileId:Id):Promise<PublicProfile>=>{const {profile,revision}=await profiles.setActive(profileId);if(revision!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed while selecting');const isEncrypted=await profileEncryptionStatus(profileId);if(revision!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed while selecting');return{...profile,isEncrypted}},
 active:async():Promise<PublicProfile>=>{if(!activeProfileId)throw new CoreError('NOT_FOUND','No active profile');const profileId=activeProfileId,revision=ensureProfile(profileId),p=await db.profiles.get(profileId);if(!p)throw new CoreError('NOT_FOUND','Active profile not found');if(revision!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed while reading active profile');const isEncrypted=await profileEncryptionStatus(profileId);if(revision!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed while reading active profile');return{...p,isEncrypted}},
 clearActive:(profileId?:string,expectedVault?:object)=>{if(profileId&&activeProfileId!==profileId)return;if(expectedVault&&activeVault!==expectedVault)return;if(activeVault)expireVault(activeVault);else{if(activeProfileId)sessionChannel.invalidate(activeProfileId);activeProfileId=null;sessionRevision++}},
 delete:async(profileId:Id)=>{const revision=ensureProfile(profileId);await db.transaction('rw',[db.profiles,...tables()],async()=>{if(!await db.profiles.get(profileId))throw new CoreError('NOT_FOUND','Profile not found');for(const t of tables())await t.where('profileId').equals(profileId).delete();await db.profiles.delete(profileId);if(revision!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed during deletion')});if(activeProfileId===profileId)profiles.clearActive()},
 wipe:async(profileId:Id):Promise<ProfileWipeResult>=>{const wasActive=activeProfileId===profileId,revision=wasActive?ensureProfile(profileId):sessionRevision;await db.transaction('rw',[db.profiles,...tables()],async()=>{if(!await db.profiles.get(profileId))throw new CoreError('NOT_FOUND','Profile not found');for(const t of tables())await t.where('profileId').equals(profileId).delete();const remaining=await Promise.all(tables().map(t=>t.where('profileId').equals(profileId).count()));if(remaining.some(n=>n>0))throw new CoreError('UNKNOWN','Profile data wipe was incomplete');if(revision!==sessionRevision||(wasActive&&activeProfileId!==profileId))throw new CoreError('LOCKED','Profile context changed during wipe')});if(activeProfileId===profileId)profiles.clearActive(profileId);else sessionChannel.invalidate(profileId);return{profileId,wiped:true}}
};
export const scoped={
 add:async<T extends BaseEntity>(table:Table<T,string>,profileId:Id,value:Omit<T,'id'|'profileId'|'createdAt'|'updatedAt'>):Promise<T>=>{const rev=ensureProfile(profileId),normalized=validateWrite(table,value);const setting=await db.settings.where('profileId').equals(profileId).first();const time=stamp(),row={...(normalized as object),id:uuid(),profileId,createdAt:time,updatedAt:time,...(table.name==='checkins'?{loggedAt:time}:{})}as T & {encryptedPayload?:unknown};const payload:Record<string,unknown>={};for(const key of ['data','symptoms','notes','conditions','allergies','medications','birthDate','title','message','metadata'])if(key in row){payload[key]=(row as unknown as Record<string,unknown>)[key];delete (row as unknown as Record<string,unknown>)[key]};if(setting?.pinEnabled){if(!activeVault?.key)throw new CoreError('LOCKED','Unlock this profile to write health data');const meta={profileId,id:row.id,journey:'journey'in row?String(row.journey):'',type:'type'in row?String(row.type):'',updatedAt:row.updatedAt};row.encryptedPayload=await encryptPayload(activeVault.key,payload,meta)}else Object.assign(row,payload);if(rev!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed during write');try{await db.transaction('rw',table,async()=>{if(rev!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed during write');await table.add(row);if(rev!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed during write')});return await scoped.get(table,profileId,row.id)}catch(e){if(isQuota(e))throw new CoreError('STORAGE_FULL','Storage is full');throw e}},
 list:async<T extends BaseEntity>(table:Table<T,string>,profileId:Id):Promise<T[]>=>{const rev=ensureProfile(profileId),setting=await db.settings.where('profileId').equals(profileId).first();if(setting?.pinEnabled&&!activeVault?.key)throw new CoreError('LOCKED','Unlock this profile to read health data');const rows=await table.where('profileId').equals(profileId).toArray();if(rev!==sessionRevision)throw new CoreError('LOCKED','Profile changed during read');const decoded=await Promise.all(rows.map(r=>scoped.decode(r,setting)));if(rev!==sessionRevision)throw new CoreError('LOCKED','Profile changed during read');return decoded},
 decode:async<T extends BaseEntity>(row:T,setting?:Settings):Promise<T>=>{const revision=sessionRevision,stored=row as T & {encryptedPayload?:{iv:number[];cipher:number[]}},sensitive=['data','symptoms','notes','conditions','allergies','medications','birthDate','title','message','metadata'];if(stored.encryptedPayload&&!setting?.pinEnabled)throw new CoreError('CRYPTO','Record encryption metadata is inconsistent');if(!stored.encryptedPayload){if(setting?.pinEnabled&&sensitive.some(k=>k in(row as object)))throw new CoreError('CRYPTO','Protected record is stored without encryption');return row}if(!activeVault?.key||activeVault.profileId!==row.profileId)throw new CoreError('LOCKED','Profile is locked');try{const meta={profileId:row.profileId,id:row.id,journey:'journey'in row?String((row as T & {journey?:string}).journey??''):'',type:'type'in row?String((row as T & {type?:string}).type??''):'',updatedAt:row.updatedAt};const payload=await decryptPayload(activeVault.key,stored.encryptedPayload,meta);if(revision!==sessionRevision||activeProfileId!==row.profileId)throw new CoreError('LOCKED','Profile changed during decryption');delete stored.encryptedPayload;return Object.assign(row,payload)}catch(e){if(e instanceof CoreError)throw e;throw new CoreError('CRYPTO','Encrypted record could not be authenticated')}},
 get:async<T extends BaseEntity>(table:Table<T,string>,profileId:Id,id:string):Promise<T>=>{const rev=ensureProfile(profileId);const setting=await db.settings.where('profileId').equals(profileId).first();const row=await table.get(id);if(!row||row.profileId!==profileId)throw new CoreError('NOT_FOUND','Record not found');if(rev!==sessionRevision)throw new CoreError('LOCKED','Profile changed during read');const decoded=await scoped.decode(row,setting);if(rev!==sessionRevision)throw new CoreError('LOCKED','Profile changed during read');return decoded},
 update:async<T extends BaseEntity>(table:Table<T,string>,profileId:Id,id:string,patch:Partial<T>):Promise<T>=>{const revision=ensureProfile(profileId),current=await scoped.get(table,profileId,id);const next={...current,...patch,id,profileId,createdAt:current.createdAt,updatedAt:stamp(),...(table.name==='checkins'?{loggedAt:(current as T&{loggedAt?:string}).loggedAt}:{})} as T & {encryptedPayload?:unknown};const setting=await db.settings.where('profileId').equals(profileId).first();const payload:Record<string,unknown>={};for(const key of ['data','symptoms','notes','conditions','allergies','medications','birthDate','title','message','metadata'])if(key in next){payload[key]=(next as unknown as Record<string,unknown>)[key];delete(next as unknown as Record<string,unknown>)[key]};const writable={...next} as Record<string,unknown>;for(const key of ['id','profileId','createdAt','updatedAt','loggedAt','encryptedPayload'])delete writable[key];Object.assign(writable,payload);const normalized=validateWrite(table,writable);Object.assign(next,normalized);if(setting?.pinEnabled){if(!activeVault?.key)throw new CoreError('LOCKED','Unlock this profile to update health data');for(const key of Object.keys(payload))delete(next as unknown as Record<string,unknown>)[key];const meta={profileId,id,journey:'journey'in next?String(next.journey):'',type:'type'in next?String(next.type):'',updatedAt:next.updatedAt};next.encryptedPayload=await encryptPayload(activeVault.key,payload,meta)}else Object.assign(next,payload);try{await db.transaction('rw',table,async()=>{if(revision!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed during update');await table.put(next);if(revision!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed during update')});return await scoped.get(table,profileId,id)}catch(e){if(isQuota(e))throw new CoreError('STORAGE_FULL','Storage is full');throw e}},
 delete:async<T extends BaseEntity>(table:Table<T,string>,profileId:Id,id:string)=>{const revision=ensureProfile(profileId);await scoped.get(table,profileId,id);await db.transaction('rw',table,async()=>{if(revision!==sessionRevision||activeProfileId!==profileId)throw new CoreError('LOCKED','Profile changed during delete');const row=await table.get(id);if(!row||row.profileId!==profileId)throw new CoreError('NOT_FOUND','Record not found');await table.delete(id)})},
