/** Seeds conspicuously synthetic demo rows; these values are not health guidance or user data. */
export const sampleData={
 load:async(profileId:string)=>{const date=new Date().toISOString().slice(0,10);const existingChecks=await scoped.list(db.checkins,profileId),existingRecords=await scoped.list(db.records,profileId);let created=0;for(const journey of ['menstrual','maternity','menopause'] as const){if(!existingChecks.some(row=>row.isSample===true&&row.journey===journey)){await scoped.add(db.checkins,profileId,{journey,date,kind:'demo',symptoms:[],data:{demoLabel:'Synthetic demonstration only'},isSample:true});created++}if(!existingRecords.some(row=>row.isSample===true&&row.journey===journey)){await scoped.add(db.records,profileId,{journey,type:'demo',date,title:'Synthetic example',data:{demoLabel:'Synthetic demonstration only'},isSample:true});created++}}return{created,isSample:true as const}},
 reset:async(profileId:string)=>{let deleted=0;for(const table of [db.checkins,db.records,db.appointments,db.notifications,db.bookmarks,db.recentlyViewed,db.consents] as Table<BaseEntity,string>[]){for(const row of await scoped.list(table,profileId)){if((row as BaseEntity&{isSample?:boolean}).isSample===true){await scoped.delete(table,profileId,row.id);deleted++}}}return{deleted}}
};








