$file = ".\tests\core.test.ts"
$content = Get-Content -LiteralPath $file -Raw
$old = "reviewStatus:'reviewed' as const,triggered:false"
$new = "reviewStatus:'reviewed' as const,evaluationStatus:'evaluated' as const,triggered:false"

if (-not $content.Contains($old)) {
    Write-Host "ERROR: Expected text was not found. No changes made." -ForegroundColor Red
} else {
    $backup = ".\tests\core.test.ts.before_evaluation_fix"
    Copy-Item -LiteralPath $file -Destination $backup -Force
    $content = $content.Replace($old, $new)
    Set-Content -LiteralPath $file -Value $content -NoNewline
    Write-Host "SUCCESS: Added evaluationStatus and backed up the original test." -ForegroundColor Green
}